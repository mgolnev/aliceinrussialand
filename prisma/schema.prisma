generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SocialSourcePlatform {
  TELEGRAM
  INSTAGRAM
  BEHANCE
}

model SiteSettings {
  id                   Int     @id @default(1)
  displayName          String  @default("Иллюстратор")
  /// Полное имя автора для поисковой выдачи и разметки Person; бренд в шапке остаётся отдельным.
  authorName           String  @default("")
  tagline              String  @default("")
  bio                  String  @default("")
  aboutMarkdown        String  @default("")
  avatarMediaPath      String?
  /// JSON с вариантами фото для страницы «Обо мне» (w640 / w960 / w1280).
  aboutPhotoPath       String?
  socialLinksJson      String  @default("[]")
  telegramChannelUser  String  @default("")
  /// Подпись ссылки на /about в шапке и заголовок блока соцсетей на странице «Обо мне».
  contactsLabel        String  @default("Контакты")
  defaultLocale        String  @default("ru")
  siteUrl              String  @default("http://localhost:3000")
  /// SEO title and description for the home page. Empty values fall back to the public profile copy.
  seoTitle             String  @default("")
  seoDescription       String  @default("")
  plausibleDomain      String  @default("")
  yandexMetrikaId      String  @default("")
  yandexVerification   String  @default("")
  /// Показывать экспериментальный вход в прогулку на главной странице.
  showWanderEntry      Boolean @default(true)
  /// Редактируемая надпись на бумажном входе в прогулку.
  wanderEntryLabel     String  @default("не жми сюда")
  updatedAt            DateTime @updatedAt
}

model PostCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  description String @default("")
  isArchived Boolean  @default(false)
  /// Участвуют ли публикации категории в режиме «не выбирай».
  includeInWander Boolean @default(true)
  oldSlugs   String[] @default([])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  body               String         @default("")
  displayMode        String         @default("GRID")
  status             String         @default("DRAFT")
  publishedAt        DateTime?
  pinned             Boolean        @default(false)
  showInAll          Boolean        @default(true)
  metaTitle          String         @default("")
  /// AUTO — системная заготовка, AI — результат фоновой генерации, MANUAL — правка автора.
  metaTitleSource    String         @default("AUTO")
  metaDescription    String         @default("")
  metaDescriptionSource String       @default("AUTO")
  telegramSourceUrl  String?
  sourcePlatform     SocialSourcePlatform?
  sourceUrl          String?
  sourceExternalId   String?
  oldSlugs           String[]       @default([])
  locale             String         @default("ru")
  categoryId         String?
  category           PostCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projects           PostProject[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  images             PostImage[]
  aiSeoJobs          AiSeoJob[]
  aiSeoReviews       AiSeoReview[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([status, showInAll, pinned, publishedAt(sort: Desc)])
  @@index([sourcePlatform, sourceUrl])
  @@index([sourcePlatform, sourceExternalId])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Post_title_trgm_idx", type: Gin)
  @@index([slug(ops: raw("gin_trgm_ops"))], map: "Post_slug_trgm_idx", type: Gin)
  @@index([body(ops: raw("gin_trgm_ops"))], map: "Post_body_trgm_idx", type: Gin)
}

// Авторский цикл работ, объединяющий публикации из разных категорий.
model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String        @default("")
  metaTitle       String        @default("")
  metaDescription String        @default("")
  /// NEWEST_FIRST или MANUAL. По умолчанию подборка повторяет порядок основной ленты.
  orderMode       String        @default("NEWEST_FIRST")
  /// DRAFT, PUBLISHED или ARCHIVED. Строка оставлена намеренно: статус совпадает по подходу с Post.
  status          String        @default("DRAFT")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  posts           PostProject[]
  aiSeoReviews    AiSeoReview[]

  @@index([status, updatedAt])
}

// Явная связь публикации с циклом; sortOrder задаёт порядок чтения.
model PostProject {
  id        String   @id @default(cuid())
  postId    String
  projectId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([postId, projectId])
  @@index([projectId, sortOrder])
  @@index([postId])
}

model PostImage {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  caption     String   @default("")
  alt         String   @default("")
  /// AI не изменяет alt, который автор правил сам.
  altSource   String   @default("AUTO")
  originalExt String   @default("jpg")
  width       Int?
  height      Int?
  variantsJson String  @default("{}")
  createdAt   DateTime @default(now())

  @@index([postId, sortOrder])
}

/// Устойчивая очередь фоновой SEO-обработки; `after` лишь ускоряет первый запуск.
model AiSeoJob {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// POST_SEO или IMAGE_ALT. Строка оставлена для будущих автоматизаций без миграции enum.
  type        String
  /// POST для метаданных или id конкретной картинки для alt.
  subjectKey  String
  /// PENDING, RUNNING, DONE, REVIEW, FAILED.
  status      String   @default("PENDING")
  /// Меняется при каждой постановке в очередь: старый ответ никогда не перезапишет новый текст.
  revision    Int      @default(0)
  inputHash   String   @default("")
  outputJson  String   @default("{}")
  attempts    Int      @default(0)
  runAfter    DateTime @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  lastError   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([postId, type, subjectKey])
  @@index([status, runAfter])
  @@index([postId, updatedAt])
}

// Предложения AI живут отдельно от опубликованных полей: автор всегда видит
// вариант и сам решает, применить его или оставить текущий текст.
model AiSeoReview {
  id                   String   @id @default(cuid())
  postId               String?  @unique
  projectId            String?  @unique
  post                 Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  project              Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // CRITICAL — общий/дублирующийся title; IMPROVE — уточнение уже заполненного текста.
  priority             String
  // PENDING, RUNNING, READY, APPLIED, DISMISSED, FAILED.
  status               String   @default("PENDING")
  revision             Int      @default(0)
  inputHash            String   @default("")
  suggestedTitle       String   @default("")
  suggestedDescription String   @default("")
  confidence           Float    @default(0)
  attempts             Int      @default(0)
  runAfter             DateTime @default(now())
  lockedAt             DateTime?
  completedAt          DateTime?
  appliedAt            DateTime?
  dismissedAt          DateTime?
  lastError            String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, runAfter])
  @@index([priority, status, updatedAt])
}
